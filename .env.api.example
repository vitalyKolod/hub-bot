# Separate local database and test Telegram bot. Never use production values for dev:stack.
MONGO_URI=mongodb://127.0.0.1:27017/hub_local
BOT_TOKEN=replace_with_test_bot_token
API_HOST=127.0.0.1
API_PORT=3001
API_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local only. Disabled unconditionally when NODE_ENV=production.
ALLOW_DEV_AUTH=true
ADMIN_IDS=9001
ADMIN_ID=9001
PAYMENT_CARD=replace_with_test_requisites
PAYMENT_SBP=replace_with_test_requisites
PAYMENT_RECEIVER_NAME=Test recipient
# Use chat/topic IDs belonging to the test bot for live Telegram integration.
ADMIN_GROUP_ID=100001
CONTENT_GROUP_ID=100002
SUPPORT_GROUP_ID=100003
SUNDAY_SCREENS_GROUP_ID=100004
PROP_WAITLIST_THREAD_ID=100005
PROP_STREAM_VERIFY_THREAD_ID=100006
PROP_DEVICE_REQUEST_THREAD_ID=100007
YANDEX360_THREAD_ID=100008
