# Local browser auth is opt-in. Keep this false outside local development.
ALLOW_DEV_AUTH=false

# Set to the deployed HTTPS Mini App URL for staging/production only.
MINI_APP_URL=

# Support conversation inactivity timeout (hours).
SUPPORT_AUTO_CLOSE_HOURS=1

# Operational event forum
LOG_GROUP_ID=-1004463392579
LOG_THREAD_REGISTRATION=2
LOG_THREAD_TEAMS=4
# Optional additional HUB topic for device events in LOG_GROUP_ID
LOG_THREAD_HUB=0
LOG_THREAD_ORDERS=6
LOG_THREAD_SUBSCRIPTIONS=8
LOG_THREAD_ACCESS=10
LOG_THREAD_ERRORS=12

# ID отдельной темы Яндекс 360 в ADMIN_GROUP_ID; команда /threadid внутри темы
YANDEX360_THREAD_ID=

# Тема сводок продления ProPresenter в группе заявок для администраторов.
PROP_RENEWAL_STATS_THREAD_ID=1164
PROP_DEVICE_REQUEST_THREAD_ID=1159
PROP_DEVICE_PRICE_RUB=4000
