{
  "name": "bot-hub",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx index.ts",
    "start:api": "tsx api.ts",
    "dev": "nodemon --exec npx tsx index.ts",
    "dev:api": "nodemon --exec npx tsx api.ts",
    "dev:stack": "node scripts/dev-stack.mjs",
    "build": "tsc --noEmit --noCheck",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "test": "node --import tsx --import ./test/env.ts --test test/*.test.ts",
    "dev:api:demo": "tsx scripts/dev-api-demo.ts",
    "test:api:integration": "node --import tsx --test test/api.integration.ts",
    "check:api:indexes": "tsx scripts/check-api-indexes.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@grammyjs/menu": "^1.3.1",
    "@grammyjs/parse-mode": "^2.3.0",
    "dotenv": "^17.2.4",
    "grammy": "^1.40.0",
    "luxon": "^3.7.2",
    "mongodb": "^7.2.0",
    "mongoose": "^9.4.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "mongodb-memory-server-core": "^11.3.0",
    "nodemon": "^3.1.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": ".cache/mongodb",
      "version": "8.2.6"
    }
  }
}
